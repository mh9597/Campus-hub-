# Normalize line endings for all text files automatically
* text=auto

# Force LF for shell scripts
*.sh text eol=lf

# Force LF for JS/JSX/TS/TSX source files (cross-platform consistency)
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.env  text eol=lf

# Binary files — do not touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.svg  binary
*.ico  binary
*.otf  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.pdf  binary
