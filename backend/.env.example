# ─────────────────────────────────────────────
#  Student Resource Hub — Server Environment
# ─────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# MySQL Database (Prisma connection string)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:yourpassword@localhost:3306/student_resource_hub"

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace_with_a_strong_random_secret_for_access_tokens"
JWT_REFRESH_SECRET="replace_with_a_different_strong_random_secret_for_refresh_tokens"

# Token expiry
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_MS=604800000

# CORS — Frontend origin (Vite dev server)
CLIENT_ORIGIN="http://localhost:5173"

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
